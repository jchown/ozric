@using Ozric.Dashboard.Model
@using Ozric.Engine.Graph
@using Ozric.Engine.Nodes

<MudDialog>
    <DialogContent>

        <MudContainer Style="max-height: 60vh; overflow-y: scroll">

            <MudTextField Label="Title" HelperText="The unique name for this node" @bind-Value="ID" For="@(() => ID)" Immediate="true" />
            
            <MudDivider DividerType="DividerType.Middle" Class="my-4" />

            <MudTextField Label="Type" HelperText="The type of this node" Value="Type" Disabled="true" />

            <MudDivider DividerType="DividerType.Middle" Class="my-4" />

            <MudText Typo="Typo.caption" Class="mb-1">Inputs</MudText>
            
            <MudTable Items="Node.inputs" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nr">@context.name</MudTd>
                    <MudTd DataLabel="Sign">@context.type</MudTd>
                    <MudTd DataLabel="Source">@DescribeSource(context)</MudTd>
                    <MudTd DataLabel="Value">@context.value</MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider DividerType="DividerType.Middle" Class="my-4" />

            <MudText Typo="Typo.caption" Class="mb-1">Outputs</MudText>
            
            <MudTable Items="Node.outputs" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nr">@context.name</MudTd>
                    <MudTd DataLabel="Sign">@context.type</MudTd>
                    <MudTd DataLabel="Destination">@DescribeDestination(context)</MudTd>
                    <MudTd DataLabel="Value">@context.value</MudTd>
                </RowTemplate>
            </MudTable>

        </MudContainer>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Save" Disabled="!HasChanges">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Graph Graph { get; set; }

    [Parameter]
    public DiagramNode Model { get; set; }

    [Parameter]
    public GraphNode Node { get; set; }
    
    private string ID { get; set; }
    private NodeType Type;

    void Cancel() => MudDialog.Cancel();
    void Save() => MudDialog.Close(DialogResult.Ok(GetChanges()));
    
    private bool HasChanges => GetChanges().Count > 0;
    
    protected override void OnInitialized()
    {
        ID = Node.id;
        Type = Node.nodeType;
    }
    
    private IList<GraphEditAction> GetChanges()
    {
        if (ID != Node.id)
            return new List<GraphEditAction> { new GraphEditAction.RenameNode(Node, ID) };

        return GraphEditAction.NoChanges;
    }

    private IReadOnlyCollection<TreeItemData<Pin?>> InputTree()
    {
        return Node.inputs.Select(i => new TreeItemData<Pin?>
        {
            Text = i.name,
        }).ToList();
    }

    private IReadOnlyCollection<TreeItemData<Pin?>> OutputTree()
    {
        return Node.outputs.Select(i => new TreeItemData<Pin?>
        {
            Text = i.name,
        }).ToList();
    }

    private string DescribeSource(Pin pin)
    {
        var source = Graph.edges.Values.FirstOrDefault(ge => ge.to.nodeID == Node.id && ge.to.inputName == pin.name);
        if (source == null)
            return "<unconnected>";
        
        return $"{source.from.nodeID} {source.from.outputName}";
    }

    private string DescribeDestination(Pin pin)
    {
        var destination = Graph.edges.Values.FirstOrDefault(ge => ge.from.nodeID == Node.id && ge.from.outputName == pin.name);
        if (destination == null)
            return "<unconnected>";
        
        return $"{destination.to.nodeID} {destination.to.inputName}";
    }
}
